KICKBACK_ENV=sandbox
DATABASE_URL=postgres://kickback:kickback@localhost:55432/kickback
POSTGRES_PORT=55432
APP_URL=http://localhost:3000
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_ID=
PAYPAL_BN_CODE=
PAYPAL_WEBHOOK_ID=
MERCHANT_ROSAS_ID=
MERCHANT_SALON_ID=
MERCHANT_BAKERY_ID=
# Optional merchant-owned webhook registrations, including dispute listeners.
MERCHANT_ROSAS_WEBHOOK_ID=
MERCHANT_SALON_WEBHOOK_ID=
MERCHANT_BAKERY_WEBHOOK_ID=
# Optional first-party fallback; use a merchant's own app ID in the browser too.
MERCHANT_ROSAS_CLIENT_ID=
MERCHANT_ROSAS_CLIENT_SECRET=
MERCHANT_SALON_CLIENT_ID=
MERCHANT_SALON_CLIENT_SECRET=
MERCHANT_BAKERY_CLIENT_ID=
MERCHANT_BAKERY_CLIENT_SECRET=
PAYPAL_CONNECTION_MODE=partner
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_ENABLED=true
AI_EFFORT_DESIGNER=high
AI_MAX_CALLS_PER_MERCHANT_PER_DAY=30
AI_MAX_ANALYST_TURNS_PER_MERCHANT_PER_DAY=80
AI_EFFORT_ANALYST=low
KICKBACK_MASTER_KEY=
JOBS_BEARER=
KICKBACK_ALLOW_UNVERIFIED_WEBHOOKS=false
DEMO_MODE=false
PG_POOL_MAX=5
PAYPAL_RATE_PER_MIN=40
KICKBACK_PAUSE_REWARDS=false
REWARD_SETTLE_IMMEDIATE=true
# Saved sandbox wallet for replay; never expose to browsers or commit its value.
PAYPAL_DEMO_VAULT_ID=
MERCHANT_ROSAS_VAULT_ID=
MERCHANT_SALON_VAULT_ID=
MERCHANT_BAKERY_VAULT_ID=
# Optional bearer for --remote replay when local and hosted job keys differ.
REMOTE_JOBS_BEARER=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DEMO_USER_PASSWORD=
PAYPAL_LOGIN_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
TENANT_PURGE_HOURS=48
RECONCILE_INTERVAL_HOURS=6
BACKFILL_DAYS=90
# Private customer summary links, reissued after recognized captures.
PROGRESS_LINK_TTL_DAYS=365
# Optional Sentry Security Header report URI, not the SDK DSN.
SENTRY_CSP_REPORT_URL=
# Optional Render task trigger access; keep the user API key out of source control.
RENDER_API_KEY=
WORKFLOW_SLUG=
# Read-only demo and evaluator paths (sandbox only; rejected in live mode).
# Local tools such as /dev/pay-test; keep false on any public deployment.
PUBLIC_SANDBOX_TOOLS=true
# Server-only password for viewer@kickback.local; nobody signs in with it by hand.
DEMO_VIEWER_PASSWORD=
# Hides "Watch a reward happen" and "Pay as a customer" on /demo when false.
DEMO_PATHS_ENABLED=true
DEMO_RUNS_PER_DAY=30
# Published sandbox buyer logins shown on /demo: [{"email":"...","password":"..."}]
DEMO_BUYER_CREDENTIALS_JSON=
# Demo shops that disconnect and purge refuse; ALLOW_DEMO_TENANT_PURGE=true overrides once.
PROTECTED_DEMO_SLUGS=rosas,salon,bakery
ALLOW_DEMO_TENANT_PURGE=false
# Platform-wide AI ceilings per UTC day, and the separate lane for demo visitors.
AI_MAX_CALLS_GLOBAL_PER_DAY=200
AI_MAX_ANALYST_TURNS_GLOBAL_PER_DAY=400
AI_MAX_VIEWER_TURNS_PER_IP_PER_DAY=15
AI_MAX_VIEWER_TURNS_PER_DAY=150
# Optional uptime monitor heartbeats and public status page link.
BETTERSTACK_JOBS_HEARTBEAT_URL=
BETTERSTACK_SOAK_HEARTBEAT_URL=
BETTERSTACK_RECONCILE_HEARTBEAT_URL=
STATUS_PAGE_URL=
